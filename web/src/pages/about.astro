---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, closing } from '../site.config';

const description = `${site.name} — enterprise AI transformation leader. 15+ years building AI from zero to scale, across classical machine learning, GenAI, RAG and agentic platforms in regulated enterprise environments.`;

const jsonLd = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/about#page`,
    url: `${site.url}/about`,
    name: `About ${site.name}`,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${site.url}/about#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` },
    ],
  },
];

const principles = [
  {
    title: 'The model is a commodity',
    body: 'Same model, radically different outcomes. What separates them is system design, data quality, retrieval architecture and the shape of the context you hand it — not the frontier release on the label.',
  },
  {
    title: 'Governance from day one',
    body: 'Data boundaries, DLP, PII handling and responsible-AI review are cheap to design in and expensive to retrofit. In regulated environments they are also the difference between a pilot and something that ships.',
  },
  {
    title: 'Adoption is the product',
    body: 'A platform nobody opens has delivered nothing. Most resistance is rational — people burned by earlier tools, missing access, misaligned incentives — and each of those needs a different intervention.',
  },
];

const career = [
  {
    period: 'Sept 2025 — present',
    role: 'Enterprise AI & Sales Transformation Leader',
    org: 'WNS Global Services (now Capgemini) · Gurugram',
    note: 'Enabling the commercial organisation with AI — owning the architecture, governance and adoption for in-house, enterprise-governed AI tools built to sit safely inside the business. Focused on lifting sales efficiency and cutting the manual effort sellers spend away from selling, with adoption treated as a first-class outcome rather than an afterthought. Support the sales function across every vertical, turning agentic systems from promising pilots into capability the commercial teams rely on day to day.',
  },
  {
    period: 'Nov 2019 — Sept 2025',
    role: 'AI/ML Leader — GenAI & Enterprise Intelligence',
    org: 'LTIMindtree · Bengaluru',
    note: 'Founded and led the AI/ML practice — building it from the ground up into the delivery engine for enterprise AI across the organisation, and becoming the face of the AI team to the CIO office. Stood up the first team to bring generative AI into production, ahead of the market and ahead of the mandate, and set the direction that the wider organisation later followed. Delivered across the enterprise’s core functions — a talent and HR transformation that put AI in the hands of over a hundred thousand employees, and sales enablement that gave commercial teams AI-drafted proposals and faster pursuit. Championed enterprise Copilot adoption into the core infrastructure, and collaborated with technology partners such as Snowflake and Microsoft to shape early product direction. Throughout, replaced black-box vendor tools with explainable, in-house platforms the business could own and govern — work that earned two CIO awards for its impact. The pattern across six years: see the shift early, build it in-house, and put it in production while others were still evaluating.',
  },
  {
    period: 'Mar 2019 — Oct 2019',
    role: 'Data Science & Analytics Lead',
    org: 'Dell Technologies · Bengaluru',
    note: 'Led analytics initiatives across the supply chain function, turning operational data into decisions leadership could act on. Built a multilingual product-feedback pipeline that translated customer feedback from languages across global markets into English, then applied NLP to route each issue into the right category at around 90% accuracy — layering sentiment analysis on top to separate signal from noise. Delivered the results as executive Tableau reporting that gave leadership a live view of product issues as they emerged. Worked alongside global partners to shape the analytics strategy behind it — moving the function from scattered reporting toward a single, trusted decision surface.',
  },
  {
    period: 'Feb 2018 — Feb 2019',
    role: 'Lead Data Scientist',
    org: 'Tata Consultancy Services · Bengaluru',
    note: 'Led a data science team supporting top-tier global clients across telecom and banking, building and maintaining the credit-risk models their lending decisions depended on. Applied NLP for text classification and entity extraction on enterprise document estates, and brought structure to unstructured client data at scale — sharpening both the accuracy and the speed of the insight that reached the business.',
  },
  {
    period: 'Apr 2015 — Jan 2018',
    role: 'Machine Learning Engineer',
    org: 'Ericsson · Gurugram',
    note: 'Built machine learning models for one of telecom’s most expensive problems — subscriber churn — predicting which high-value customers were likely to leave in time for the business to act, and helping protect the revenue base that retention teams fight to keep. Also delivered models for network performance analytics, along with the production Python pipelines behind them, serving operator clients across the USA and South Africa.',
  },
  {
    period: '2011 — 2015',
    role: 'Data Scientist / ML Engineer',
    org: 'Saburi TLC · Axon Network Solutions · ASMA Financial Solutions',
    note: 'Predictive analytics across telecom, networking and financial services — where the foundations were laid.',
  },
];

const education = [
  {
    award: 'MBA',
    place: 'Indian Institute of Management (IIM) Indore',
  },
  {
    award: 'B.Tech, Computer Science',
  },
];

const stack = [
  {
    group: 'Strategy & Ownership',
    items: [
      'AI Transformation Strategy & Roadmaps',
      'AI Portfolio & Investment Governance',
      'Build-vs-Buy & Vendor Strategy',
      'Executive & C-Suite Alignment',
    ],
  },
  {
    group: 'Governance & Risk',
    items: [
      'Responsible AI',
      'EU AI Act Risk-Classification',
      'DLP, PII & Data-Boundary Design',
      'Evaluation, Audit & Regression Discipline',
      'AI Adoption & Change Management',
    ],
  },
  {
    group: 'Agentic & GenAI Architecture',
    items: [
      'Multi-Agent Systems',
      'RAG & Retrieval Architecture',
      'LLMOps',
      'Grounding & Hallucination Control',
      'Human-in-the-Loop Design',
    ],
  },
  {
    group: 'Machine Learning',
    items: [
      'Machine Learning',
      'Deep Learning',
      'Predictive Modelling',
      'NLP',
      'MLOps',
    ],
  },
  {
    group: 'Platforms',
    items: [
      'Azure AI & Microsoft Copilot Stack',
      'Databricks',
      'Snowflake',
      'AWS',
      'GCP',
    ],
  },
];
---

<BaseLayout title="About" description={description} path="/about" type="profile" jsonLd={jsonLd}>
  <!-- ================= Hero ================= -->
  <section class="page-hero">
    <div class="container">
      <p class="label">About</p>
      <h1>{site.name}</h1>
      <p class="lede">
        {site.jobTitle}{site.company ? `, ${site.company}` : ''}{site.location ? ` · ${site.location}` : ''}
      </p>
    </div>
  </section>

  <!-- ================= Intro ================= -->
  <section class="section">
    <div class="container">
      <div class="prose intro-prose" data-reveal>
        <p>
          I have spent fifteen years building AI inside enterprises — first the
          models, then the platforms around them, and now the organisations that
          have to live with both. The journey has tracked the field itself: from
          classical machine learning on enterprise data, to natural language and
          people analytics at scale, to generative AI, and now agentic systems in
          production.
        </p>
        <p>
          The tools changed beyond recognition over those years. The problem
          underneath never moved. Whether the system was a classical model a
          decade ago or a multi-agent one today, the questions that decided
          everything were the same: whose data is this, who is allowed to see the
          answer, how do we know when it is wrong, and will anyone actually use
          it. The model at the centre was rarely the hard part. Everything around
          it is where the work lives.
        </p>
        <p>
          Today my work sits with the commercial function — designing the
          architecture, the governance, and the adoption that turn AI from a
          promising demo into something an enterprise runs on. I have built AI
          capabilities from the ground up and delivered platforms used across
          global organisations, and the lesson has been consistent at every
          scale: capability is not the constraint. Trust, data boundaries, and
          adoption are.
        </p>
        <p>
          That is the half of the job I write about here — the unglamorous half
          that no benchmark measures and every production system depends on. If
          the model is the easy part, this is the rest of it.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= Principles ================= -->
  <section class="section section--band">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">How I think</p>
        <div>
          <h2>Three things I keep coming back to</h2>
          <p>
            Not a philosophy. Just the patterns that have held up across enough
            organisations, and enough generations of the technology, to trust.
          </p>
        </div>
      </div>

      <div class="index" data-reveal>
        {
          principles.map((p, i) => (
            <article class="index-item">
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= Career ================= -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Background</p>
        <div>
          <h2>Where I have worked</h2>
          <p>The short version. The longer one is on LinkedIn.</p>
        </div>
      </div>

      <ol class="timeline" data-reveal>
        {
          career.map((role) => (
            <li class="timeline-item">
              <div class="timeline-period label">{role.period}</div>
              <div class="timeline-body">
                <h3>{role.role}</h3>
                <p class="timeline-org">{role.org}</p>
                <p>{role.note}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="linkedin-line">
        <a href={site.linkedin} rel="me noopener" target="_blank" class="more-link">
          Full history on LinkedIn <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ================= Education & stack ================= -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Credentials</p>
        <div>
          <h2>Education and the stack I build on</h2>
          <p>
            Tools change every eighteen months. These are the ones currently in
            hand.
          </p>
        </div>
      </div>

      <ul class="education" data-reveal>
        {
          education.map((e) => (
            <li class="education-item">
              <span class="education-award">{e.award}</span>
              {e.place && <span class="education-place">{e.place}</span>}
            </li>
          ))
        }
      </ul>

      <div class="stack-block" data-reveal>
        <p class="label stack-title">How I work</p>
        <div class="stack">
          {
            stack.map((cat) => (
              <div class="stack-row">
                <h3 class="stack-group">{cat.group}</h3>
                <ul class="stack-tags">
                  {cat.items.map((tool) => <li>{tool}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Closing ================= -->
  <section class="section section--tight">
    <div class="container">
      <div class="callout" data-reveal>
        <div>
          <h2>{closing.heading}</h2>
          <p>{closing.body}</p>
        </div>
        <div class="btn-row">
          <a href="/contact" class="button">
            Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-hero h1 {
    margin: 0.75rem 0 0.9rem;
  }

  /* ---- Intro ---- */
  /* Overrides the global .prose reading measure (38rem): with the sidebar
     gone there is nothing beside this block, so it runs the full container. */
  .intro-prose {
    max-width: none;
    font-size: var(--step-1);
    line-height: 1.68;
  }
  .intro-prose p:last-child {
    margin-bottom: 0;
  }

  /* ---- Timeline ---- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-firm);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 52rem) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .timeline-period {
    padding-top: 0.4rem;
    color: var(--muted);
  }
  @media (max-width: 52rem) {
    .timeline-period {
      padding-top: 0;
    }
  }
  .timeline-body h3 {
    font-size: 1.12rem;
    margin: 0 0 0.3rem;
    line-height: 1.4;
  }
  .timeline-org {
    margin: 0 0 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .timeline-body > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
    max-width: 62ch;
    text-wrap: pretty;
  }

  .linkedin-line {
    margin: 2.25rem 0 0;
  }

  /* ---- Education ---- */
  .education {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-firm);
  }
  .education-item {
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }
  .education-award {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }
  .education-place {
    display: block;
    font-weight: 400;
    font-size: 0.98rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  /* ---- How I work ---- */
  .stack-block {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }
  .stack-title {
    margin: 0 0 1.4rem;
  }

  /* Group label on the left, its tags on the right. */
  .stack-row {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: 1rem 1.5rem;
    align-items: start;
    padding-block: 1.1rem;
  }
  .stack-row + .stack-row {
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 46rem) {
    .stack-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .stack-group {
    margin: 0;
    padding-top: 0.25rem;
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }

  .stack-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stack-tags li {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    line-height: 1;
    color: var(--ink-soft);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
</style>
