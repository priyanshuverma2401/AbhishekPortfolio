---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, closing } from '../site.config';

const description = `${site.name} — enterprise AI transformation leader. 15+ years building AI from zero to scale, across classical machine learning, GenAI, RAG and agentic platforms in regulated enterprise environments.`;

const jsonLd = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/about#page`,
    url: `${site.url}/about`,
    name: `About ${site.name}`,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${site.url}/about#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` },
    ],
  },
];

const principles = [
  {
    title: 'The model is a commodity',
    body: 'Same model, radically different outcomes. What separates them is system design, data quality, retrieval architecture and the shape of the context you hand it — not the frontier release on the label.',
  },
  {
    title: 'Governance from day one',
    body: 'Data boundaries, DLP, PII handling and responsible-AI review are cheap to design in and expensive to retrofit. In regulated environments they are also the difference between a pilot and something that ships.',
  },
  {
    title: 'Adoption is the product',
    body: 'A platform nobody opens has delivered nothing. Most resistance is rational — people burned by earlier tools, missing access, misaligned incentives — and each of those needs a different intervention.',
  },
];

const career = [
  {
    period: 'Sept 2025 — present',
    role: 'Senior Consultant (AVP), Enterprise AI & Sales Transformation',
    org: 'WNS Global Services (now Capgemini) · Gurugram',
    note: 'AI strategy and portfolio for the commercial function of a $3.3B organisation — architecture, governance and investment decisions, reporting to global commercial leadership. Built the GTM intelligence layer: a proprietary account-signal platform and a production account-planning agent, now serving 300+ users across a $570M+ deal portfolio.',
  },
  {
    period: 'Nov 2019 — Sept 2025',
    role: 'Director, AI/ML Solutions, GenAI Products & Enterprise Intelligence',
    org: 'LTIMindtree · Bengaluru',
    note: 'Built and led a 20-person AI/ML practice from zero inside the CIO organisation, owning a ~$500K annual cost base. Shipped the organisation’s first production GenAI solutions in 2023, and a 100,000-user AI talent marketplace that replaced a ~$200K black-box vendor licence with an explainable in-house platform.',
  },
  {
    period: 'Mar 2019 — Oct 2019',
    role: 'Advisor, Data Science & Analytics',
    org: 'Dell Technologies · Bengaluru',
    note: 'Predictive analytics across TB+ consumer datasets, end to end from data sourcing through production integration — a 20% operational efficiency improvement.',
  },
  {
    period: 'Feb 2018 — Feb 2019',
    role: 'Lead Data Scientist',
    org: 'Tata Consultancy Services · Bengaluru',
    note: 'Led a three-person team on NLP text classification and entity extraction for enterprise clients across the US, UK and Asia — 30% improvement in reporting accuracy.',
  },
  {
    period: 'Apr 2015 — Jan 2018',
    role: 'Machine Learning Engineer',
    org: 'Ericsson · Gurugram',
    note: 'Regression, classification and churn models for telecom network performance analytics, and the Python pipelines behind them, for clients in the USA and South Africa.',
  },
  {
    period: '2011 — 2015',
    role: 'Data Scientist / ML Engineer',
    org: 'Saburi TLC · Axon Network Solutions · ASMA Financial Solutions',
    note: 'Churn prediction, customer segmentation, demand forecasting and revenue analytics across telecom, networking and financial services — where the Python, SQL and statistical foundations were laid.',
  },
];

const education = [
  {
    award: 'MBA',
    place: 'Indian Institute of Management (IIM) Indore',
  },
  {
    award: 'B.Tech, Computer Science',
  },
];

const stack = [
  'Python', 'SQL', 'Azure ML', 'Azure OpenAI', 'Azure AI Search', 'Azure APIM',
  'Azure Monitor', 'Azure DevOps', 'Copilot Studio', 'Power Platform', 'LangChain',
  'LangGraph', 'RAG pipelines', 'Vector databases', 'Prompt engineering', 'LLMs',
  'LLMOps', 'Machine learning', 'Deep learning', 'NLP', 'scikit-learn', 'PySpark',
  'Databricks', 'Snowflake', 'AWS', 'GCP', 'Power BI', 'FastAPI', 'Docker',
  'MLOps', 'Streamlit',
];
---

<BaseLayout title="About" description={description} path="/about" type="profile" jsonLd={jsonLd}>
  <!-- ================= Hero ================= -->
  <section class="page-hero">
    <div class="container">
      <p class="label">About</p>
      <h1>{site.name}</h1>
      <p class="lede">
        {site.jobTitle}{site.company ? `, ${site.company}` : ''}{site.location ? ` · ${site.location}` : ''}
      </p>
    </div>
  </section>

  <!-- ================= Intro ================= -->
  <section class="section">
    <div class="container">
      <div class="prose intro-prose" data-reveal>
        <p>
          I have spent fifteen years building AI inside enterprises — first the
          models, then the platforms around them, and now the organisations that
          have to live with both. The journey has tracked the field itself: from
          classical machine learning on enterprise data, to natural language and
          people analytics at scale, to generative AI, and now agentic systems in
          production.
        </p>
        <p>
          The tools changed beyond recognition over those years. The problem
          underneath never moved. Whether the system was a classical model a
          decade ago or a multi-agent one today, the questions that decided
          everything were the same: whose data is this, who is allowed to see the
          answer, how do we know when it is wrong, and will anyone actually use
          it. The model at the centre was rarely the hard part. Everything around
          it is where the work lives.
        </p>
        <p>
          Today my work sits with the commercial function — designing the
          architecture, the governance, and the adoption that turn AI from a
          promising demo into something an enterprise runs on. I have built AI
          capabilities from the ground up and delivered platforms used across
          global organisations, and the lesson has been consistent at every
          scale: capability is not the constraint. Trust, data boundaries, and
          adoption are.
        </p>
        <p>
          That is the half of the job I write about here — the unglamorous half
          that no benchmark measures and every production system depends on. If
          the model is the easy part, this is the rest of it.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= Principles ================= -->
  <section class="section section--band">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">How I think</p>
        <div>
          <h2>Three things I keep coming back to</h2>
          <p>
            Not a philosophy. Just the patterns that have held up across enough
            organisations, and enough generations of the technology, to trust.
          </p>
        </div>
      </div>

      <div class="index" data-reveal>
        {
          principles.map((p, i) => (
            <article class="index-item">
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= Career ================= -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Background</p>
        <div>
          <h2>Where I have worked</h2>
          <p>The short version. The longer one is on LinkedIn.</p>
        </div>
      </div>

      <ol class="timeline" data-reveal>
        {
          career.map((role) => (
            <li class="timeline-item">
              <div class="timeline-period label">{role.period}</div>
              <div class="timeline-body">
                <h3>{role.role}</h3>
                <p class="timeline-org">{role.org}</p>
                <p>{role.note}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="linkedin-line">
        <a href={site.linkedin} rel="me noopener" target="_blank" class="more-link">
          Full history on LinkedIn <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ================= Education & stack ================= -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Credentials</p>
        <div>
          <h2>Education and the stack I build on</h2>
          <p>
            Tools change every eighteen months. These are the ones currently in
            hand.
          </p>
        </div>
      </div>

      <ul class="education" data-reveal>
        {
          education.map((e) => (
            <li class="education-item">
              <span class="education-award">{e.award}</span>
              {e.place && <span class="education-place">{e.place}</span>}
            </li>
          ))
        }
      </ul>

      <div class="stack-block" data-reveal>
        <p class="label stack-title">Technical stack</p>
        <ul class="stack">
          {stack.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= Closing ================= -->
  <section class="section section--tight">
    <div class="container">
      <div class="callout" data-reveal>
        <div>
          <h2>{closing.heading}</h2>
          <p>{closing.body}</p>
        </div>
        <div class="btn-row">
          <a href="/contact" class="button">
            Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-hero h1 {
    margin: 0.75rem 0 0.9rem;
  }

  /* ---- Intro ---- */
  /* Overrides the global .prose reading measure (38rem): with the sidebar
     gone there is nothing beside this block, so it runs the full container. */
  .intro-prose {
    max-width: none;
    font-size: var(--step-1);
    line-height: 1.68;
  }
  .intro-prose p:last-child {
    margin-bottom: 0;
  }

  /* ---- Timeline ---- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-firm);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 52rem) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .timeline-period {
    padding-top: 0.4rem;
    color: var(--muted);
  }
  @media (max-width: 52rem) {
    .timeline-period {
      padding-top: 0;
    }
  }
  .timeline-body h3 {
    font-size: 1.12rem;
    margin: 0 0 0.3rem;
    line-height: 1.4;
  }
  .timeline-org {
    margin: 0 0 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .timeline-body > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.68;
    max-width: 62ch;
    text-wrap: pretty;
  }

  .linkedin-line {
    margin: 2.25rem 0 0;
  }

  /* ---- Education ---- */
  .education {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-firm);
  }
  .education-item {
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }
  .education-award {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }
  .education-place {
    display: block;
    font-weight: 400;
    font-size: 0.98rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  /* ---- Stack ---- */
  .stack-block {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }
  .stack-title {
    margin: 0 0 1rem;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .stack li {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    line-height: 1;
    color: var(--ink-soft);
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
</style>
