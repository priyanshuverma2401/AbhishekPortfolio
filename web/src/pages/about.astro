---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, closing } from '../site.config';

const description = `${site.name} is ${site.jobTitle}. Two decades building engineering systems, the teams behind them, and the operating models that hold both together.`;

const jsonLd = [
  {
    '@type': 'AboutPage',
    '@id': `${site.url}/about#page`,
    url: `${site.url}/about`,
    name: `About ${site.name}`,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${site.url}/about#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` },
    ],
  },
];

// ---------------------------------------------------------------------------
// EDIT EVERYTHING BELOW. This is scaffolding in your voice — the [bracketed]
// parts are placeholders. I have deliberately not invented your career.
// ---------------------------------------------------------------------------

const principles = [
  {
    title: 'Structure before effort',
    body: 'When a team slows down, the cause is almost never how hard people are working. It is usually where a boundary was drawn, or who is allowed to decide.',
  },
  {
    title: 'Decisions over frameworks',
    body: 'Frameworks travel badly between organisations. Judgement travels — knowing which problems are structural, which are temporary, and which need someone to be told the truth.',
  },
  {
    title: 'Context is an asset',
    body: 'An engineer who has lived with a system for two years holds a map that exists nowhere else. Most reorganisations write that asset off without ever recording it.',
  },
];

const career = [
  { period: '[2021 — present]', role: '[Vice President, Engineering]', org: '[Company]', note: '[What you own, and what changed because you were there.]' },
  { period: '[2016 — 2021]', role: '[Senior Director, Engineering]', org: '[Company]', note: '[One line.]' },
  { period: '[2011 — 2016]', role: '[Engineering Manager]', org: '[Company]', note: '[One line.]' },
  { period: '[2004 — 2011]', role: '[Software Engineer]', org: '[Company]', note: '[One line.]' },
];
---

<BaseLayout title="About" description={description} path="/about" type="profile" jsonLd={jsonLd}>
  <!-- ================= Hero ================= -->
  <section class="page-hero">
    <div class="container">
      <p class="label">About</p>
      <h1>{site.name}</h1>
      <p class="lede">
        {site.jobTitle}{site.company ? `, ${site.company}` : ''}{site.location ? ` · ${site.location}` : ''}
      </p>
    </div>
  </section>

  <!-- ================= Intro ================= -->
  <section class="section">
    <div class="container intro-grid">
      <div class="prose" data-reveal>
        <p>
          I have spent the better part of two decades in engineering — first
          building systems, then building the teams that build them. Today I
          lead engineering at [company], where I am responsible for [scope:
          platform, headcount, business lines].
        </p>
        <p>
          Most of my time goes to three things: setting technical direction that
          survives contact with a roadmap, designing organisations that can
          absorb change without stalling, and developing the people who will do
          this job after me.
        </p>
        <p>
          I write here to think that through in public. The pieces are longer
          than a post and shorter than a book, and they are aimed at people
          doing this job rather than people describing it.
        </p>
      </div>

      <aside class="side" data-reveal>
        <p class="label side-title">Currently</p>
        <dl class="side-list">
          <div>
            <dt class="label">Role</dt>
            <dd>[Vice President, Engineering]</dd>
          </div>
          <div>
            <dt class="label">Focus</dt>
            <dd>[Platform modernisation at scale]</dd>
          </div>
          <div>
            <dt class="label">Team</dt>
            <dd>[~120 engineers across 3 sites]</dd>
          </div>
          <div>
            <dt class="label">Based in</dt>
            <dd>{site.location || '[City, Country]'}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- ================= Principles ================= -->
  <section class="section section--band">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">How I think</p>
        <div>
          <h2>Three things I keep coming back to</h2>
          <p>Not a philosophy. Just the patterns that have held up across enough organisations to trust.</p>
        </div>
      </div>

      <div class="index" data-reveal>
        {
          principles.map((p, i) => (
            <article class="index-item">
              <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= Career ================= -->
  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Background</p>
        <div>
          <h2>Where I have worked</h2>
          <p>The short version. The longer one is on LinkedIn.</p>
        </div>
      </div>

      <ol class="timeline" data-reveal>
        {
          career.map((role) => (
            <li class="timeline-item">
              <div class="timeline-period label">{role.period}</div>
              <div class="timeline-body">
                <h3>
                  {role.role} <span class="timeline-org">{role.org}</span>
                </h3>
                <p>{role.note}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="linkedin-line">
        <a href={site.linkedin} rel="me noopener" target="_blank" class="more-link">
          Full history on LinkedIn <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ================= Closing ================= -->
  <section class="section section--tight">
    <div class="container">
      <div class="callout" data-reveal>
        <div>
          <h2>{closing.heading}</h2>
          <p>{closing.body}</p>
        </div>
        <div class="btn-row">
          <a href="/contact" class="button">
            Get in touch <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-hero h1 {
    margin: 0.75rem 0 0.9rem;
  }

  /* ---- Intro + sidebar ---- */
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  @media (max-width: 56rem) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  .intro-grid .prose {
    font-size: var(--step-1);
    line-height: 1.68;
  }

  .side {
    border-top: 1px solid var(--rule-firm);
    padding-top: 1.1rem;
  }
  .side-title {
    margin: 0 0 1rem;
  }
  .side-list {
    margin: 0;
  }
  .side-list > div {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }
  .side-list > div:last-child {
    border-bottom: 0;
  }
  .side-list dt {
    margin-bottom: 0.25rem;
  }
  .side-list dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--ink);
    line-height: 1.45;
  }

  /* ---- Timeline ---- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-firm);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 2rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 52rem) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  .timeline-period {
    padding-top: 0.4rem;
    color: var(--muted);
  }
  @media (max-width: 52rem) {
    .timeline-period {
      padding-top: 0;
    }
  }
  .timeline-body h3 {
    font-size: 1.12rem;
    margin: 0 0 0.35rem;
    line-height: 1.4;
  }
  .timeline-org {
    color: var(--muted);
    font-weight: 400;
  }
  .timeline-body p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.65;
    max-width: 56ch;
  }

  .linkedin-line {
    margin: 2.25rem 0 0;
  }
</style>
