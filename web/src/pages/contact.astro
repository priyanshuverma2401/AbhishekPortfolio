---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const description = `Get in touch with ${site.name} — enterprise AI advisory, speaking, senior roles, and correspondence about the writing.`;

const jsonLd = [
  {
    '@type': 'ContactPage',
    '@id': `${site.url}/contact#page`,
    url: `${site.url}/contact`,
    name: `Contact ${site.name}`,
    description,
    inLanguage: site.lang,
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${site.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${site.url}/contact#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact` },
    ],
  },
];

const channels = [
  {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    note: 'Best for anything substantive. I read everything and reply to most within a week.',
  },
  {
    label: 'LinkedIn',
    value: 'Connect or message',
    href: site.linkedin,
    note: 'Fine for introductions and shorter notes. Please include context in the request itself.',
    external: true,
  },
];

const attention = [
  'Taking agentic platforms from promising pilot to governed production.',
  'AI governance that engineers adopt and leadership can enforce — DLP, evaluation, the EU AI Act as architecture.',
  'Commercial AI and GTM intelligence — where enterprise systems meet revenue outcomes.',
  'The half of the job no benchmark measures: data boundaries, trust, and adoption.',
];

const exploring = [
  'How agent portfolios get owned, evaluated and kept safe at enterprise scale.',
  'Where the human belongs in increasingly autonomous systems.',
  'The shift from picking the best model to deploying the one you can actually govern.',
  'Ideas from what I write here — including where you think I’m wrong.',
];
---

<BaseLayout title="Contact" description={description} path="/contact" jsonLd={jsonLd}>
  <!-- ================= Hero ================= -->
  <section class="page-hero">
    <div class="container">
      <p class="label">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede">
        I am glad to hear from people building AI inside real organisations. A
        line of context about who you are and what you are after will get a
        faster and more useful reply than a calendar invitation.
      </p>
    </div>
  </section>

  <!-- ================= Channels ================= -->
  <section class="section section--tight">
    <div class="container">
      <div class="card-grid" data-reveal>
        {
          channels.map((c) => (
            <a
              class="card channel"
              href={c.href}
              rel={c.external ? 'noopener' : undefined}
              target={c.external ? '_blank' : undefined}
            >
              <span class="label">{c.label}</span>
              <h2 class="channel-value">{c.value}</h2>
              <p>{c.note}</p>
              <span class="card-foot label">
                Open <span class="arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= What I think about ================= -->
  <section class="section section--band">
    <div class="container">
      <div class="section-header" data-reveal>
        <p class="label">Before you write</p>
        <div>
          <h2>What I think about</h2>
          <p>
            Not a contact form so much as an honest account of where my
            attention actually goes.
          </p>
        </div>
      </div>

      <div class="split" data-reveal>
        <div class="split-col">
          <p class="label split-title">Where my attention goes</p>
          <ul class="ticks">
            {attention.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="split-col">
          <p class="label split-title">What I’m exploring next</p>
          <ul class="ticks">
            {exploring.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Note ================= -->
  <section class="section section--tight">
    <div class="container">
      <div class="callout" data-reveal>
        <div>
          <h2>On response times</h2>
          <p>
            I answer mail in batches rather than continuously. If something is
            genuinely time-sensitive, say so in the subject line and I will move
            it forward.
          </p>
        </div>
        <div class="btn-row">
          <a href={`mailto:${site.email}`} class="button">
            Write to me <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-hero h1 {
    margin: 0.75rem 0 1.1rem;
  }
  .page-hero .lede {
    max-width: 52ch;
  }

  /* ---- Channel cards ---- */
  .channel-value {
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--ink);
    margin: 0;
    word-break: break-word;
    transition: color 140ms ease;
  }
  .channel:hover .channel-value {
    color: var(--accent);
  }

  /* ---- What I think about ---- */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--rule-firm);
  }
  @media (max-width: 52rem) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  .split-col {
    padding: 1.85rem 2rem 2rem 0;
    border-right: 1px solid var(--rule);
  }
  .split-col:last-child {
    border-right: 0;
    padding-right: 0;
  }
  @media (min-width: 52rem) {
    .split-col + .split-col {
      padding-left: 2rem;
    }
  }
  @media (max-width: 52rem) {
    .split-col {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: 1.6rem 0;
    }
    .split-col:last-child {
      border-bottom: 0;
    }
  }

  .split-title {
    margin: 0 0 1.1rem;
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.85rem;
    color: var(--ink-soft);
    font-size: 0.99rem;
    line-height: 1.65;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .ticks li:last-child {
    margin-bottom: 0;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 1px;
    background: var(--rule-firm);
  }
</style>
